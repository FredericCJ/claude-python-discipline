{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/discipline/frontmatter.schema.json",
  "title": "Discipline module front-matter",
  "description": "Implements discipline/meta/SCHEMA.md section 2.",
  "type": "object",
  "required": ["id", "kind", "title", "tokens", "decay"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(law|fact|frame|ops|meta)/[A-Za-z][A-Za-z0-9-]{1,23}$"
    },
    "kind": {
      "enum": ["law", "fact", "frame", "ops", "meta"]
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 60
    },
    "tokens": {
      "type": "integer",
      "minimum": 0
    },
    "load_when": {
      "type": "array",
      "items": { "type": "string", "minLength": 2 },
      "minItems": 3,
      "uniqueItems": true
    },
    "applies_to": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requires": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(law|fact|frame|ops|meta)/[A-Za-z][A-Za-z0-9-]*$" }
    },
    "grounds_on": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(law|fact|frame|ops|meta)/[A-Za-z][A-Za-z0-9-]*$" }
    },
    "verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "decay": {
      "enum": ["months", "quarters", "years", "none"]
    },
    "python": {
      "type": "string"
    },
    "supersedes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "enum": ["fact", "ops"] } }, "required": ["kind"] },
      "then": { "required": ["verified"] }
    },
    {
      "if": { "properties": { "kind": { "enum": ["law", "fact", "frame", "ops"] } }, "required": ["kind"] },
      "then": { "required": ["load_when"] }
    }
  ]
}
