      "test": "tools/test_learn.py::test_a_verification_that_never_ends_is_killed",
      "not_applicable": null
    }
  ],
  "states": [
    {
      "id": "ready",
      "kind": "safe",
      "entry_conditions": ["The declaration is local and every required mechanism is runnable."],
      "allowed_operations": ["validate", "navigate", "build", "install", "remove"],
      "observable_event": "DISCIPLINE-READY",
      "exit_condition": "A command completes or a required mechanism fails."
    },
    {
      "id": "gate_failed",
      "kind": "degraded",
      "entry_conditions": ["A required mechanism fails, times out, is unsupported, or is not run."],
      "allowed_operations": ["diagnose", "repair", "rerun"],
      "observable_event": "DISCIPLINE-GATE-FAILED",
      "exit_condition": "The named defect is repaired and the complete gate passes."
    }
  ],
  "budgets": [
