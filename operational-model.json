      "test": "tools/test_toolchain_gates.py::test_a_missing_configuration_is_not_silence",
      "not_applicable": null
    },
    {
      "phase": "steady_state",
      "owner_role": "application",
      "behavior": "Run declared mechanisms, build deterministic projections, or apply one bounded package operation.",
      "terminal_state": "ready",
      "test": "tools/test_gate_runner.py::test_all_passing_returns_zero",
      "not_applicable": null
    },
    {
      "phase": "interruption",
      "owner_role": "shell",
      "behavior": "Stop publishing or verification, classify the failed or timed-out step, and retain project-owned data.",
