      "test": "tools/test_gate_runner.py::test_stop_early_stops",
      "not_applicable": null
    },
    {
      "phase": "drain",
      "owner_role": "shell",
      "behavior": "Capture child output and wait for the current owned mechanism before reporting its verdict.",
      "terminal_state": "ready",
      "test": "tools/test_gate_runner.py::test_later_steps_still_run_by_default",
      "not_applicable": null
    },
    {
      "phase": "shutdown",
      "owner_role": "shell",
      "behavior": "Close local stores, remove owned staging state, and emit one complete gate or command summary.",
      "terminal_state": "ready",
      "test": "tools/test_release.py::test_caches_and_databases_are_pruned",
      "not_applicable": null
    },
    {
      "phase": "forced_cleanup",
      "owner_role": "shell",
      "behavior": "Terminate a timed-out owned child, report timeout as non-pass, and return control to the caller.",
